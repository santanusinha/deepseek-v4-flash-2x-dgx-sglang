# =============================================================================
# Environment configuration for SGLang DSPARK deployment
# =============================================================================
#
# Copy this file to .env on each node and adjust values as needed.
# Docker Compose reads .env automatically.
#
# This file makes the deployment portable: change these values to match
# your hardware and network, then run docker compose on each node.
#

# --- Model ---
MODEL_PATH=/home/santanu/data/models/DeepSeek-V4-Flash-0731

# --- Network ---
# Head node cluster IP (both nodes use this to coordinate)
HEAD_CLUSTER_IP=192.168.100.10

# RDMA / NCCL interface configuration
NCCL_IB_HCA=rocep1s0f1
NCCL_IB_GID_INDEX=3
NCCL_SOCKET_IFNAME=enp1s0f1np1
GLOO_SOCKET_IFNAME=enp1s0f1np1

# --- SGLang server ---
SGLANG_PORT=8000
DIST_INIT_PORT=20000

# --- Model serving ---
MEM_FRACTION=0.85
CONTEXT_LENGTH=131072
CHUNKED_PREFILL_SIZE=4096
MAX_RUNNING_REQUESTS=8
KV_CACHE_DTYPE=fp8_e4m3
WATCHDOG_TIMEOUT=600

# --- DSPARK ---
DSPARK_BLOCK_SIZE=5
